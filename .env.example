# Copy to .env and fill as needed
GEMINI_API_KEY=
# Preferred TTS provider: gtts | elevenlabs | polly
TTS_PROVIDER=gtts
# ElevenLabs optional
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# AWS Polly optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# General settings
OUTPUT_DIR=outputs
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
FPS=24
